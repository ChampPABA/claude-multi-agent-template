# Design Extraction: {siteName}
# Extracted: {timestamp}
# URL: {url}

meta:
  site_name: "{siteName}"
  url: "{url}"
  extracted_at: "{timestamp}"
  extractor_version: "2.1.0"
  coverage:
    total_sections: 17
    detected_sections: {detectedCount}
    percentage: {coveragePercent}

psychology:
  style_classification: "{styleClassification}"

  emotions_evoked:
    - emotion: "{emotion1}"
      reason: "{reason1}"

  target_audience:
    primary:
      description: "{audienceDescription}"
      age_range: "{ageRange}"
      tech_savvy: "{techSavvy}"

  visual_principles:
    - name: "{principle1}"
      description: "{principleDesc1}"

  why_it_works:
    - "{whyItWorks1}"

  design_philosophy:
    core_belief: "{coreBelief}"
    key_principles:
      - "{keyPrinciple1}"

sections:
  overview:
    detected: true
    style: "{styleClassification}"

  color_palette:
    detected: {hasColors}
    primary:
      # Extracted background colors
    text_colors:
      # Extracted text colors
    border_colors:
      # Extracted border colors

  typography:
    detected: {hasTypography}
    fonts: []
    weights: []
    sizes: []

  spacing_system:
    detected: {hasSpacing}
    grid_base: {gridBase}
    common_values: []

  component_styles:
    detected: {hasComponents}
    buttons: []
    cards: []
    inputs: []

  shadows_elevation:
    detected: {hasShadows}
    values: []

  animations_transitions:
    detected: {hasAnimations}
    keyframes: []
    transitions: []

  border_radius:
    detected: {hasBorderRadius}
    values: []

  border_styles:
    detected: {hasBorders}
    widths: []

  layout_patterns:
    detected: {hasLayout}
    container_width: "1280px"
    grid_columns: 12

# Detailed animation states
animations:
  # Component animation states go here
